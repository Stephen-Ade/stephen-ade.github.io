{
  "typeName": "panos/panos_nat_policy_rules",
  "provider": "panos",
  "vendor": "Palo Alto",
  "deviceType": "NAT Policy Rules",
  "supportedPlatforms": ["terraform"],
  "description": "Manages positioned NAT policy rules for PAN-OS Provider 2.0.x.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the NAT rule."
    },
    "description": {
      "type": "string",
      "description": "Description of the NAT rule."
    },
    "scope_type": {
      "type": "string",
      "description": "Where this rule lives.",
      "enum": ["device_group", "shared", "vsys"],
      "default": "device_group"
    },
    "device_group_name": {
      "type": "string",
      "description": "The Panorama device group name.",
      "visibleWhen": { "field": "scope_type", "value": "device_group" }
    },
    "vsys_name": {
      "type": "string",
      "description": "The VSYS name (e.g., vsys1).",
      "visibleWhen": { "field": "scope_type", "value": "vsys" }
    },
    "rulebase": {
      "type": "string",
      "description": "The Panorama rulebase (applies to Device Group and Shared scopes).",
      "enum": ["pre-rulebase", "post-rulebase"],
      "default": "pre-rulebase"
    },
    "position_where": {
      "type": "string",
      "description": "Position of the rule in the rulebase.",
      "enum": ["first", "last", "before", "after"],
      "default": "last"
    },
    "position_pivot": {
      "type": "string",
      "description": "Existing rule used as the before/after positioning pivot."
    },
    "position_directly": {
      "type": "boolean",
      "description": "Position directly adjacent to the pivot rule."
    },
    "source_zones": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Source zones."
    },
    "destination_zone": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Destination zones."
    },
    "source_addresses": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Source addresses."
    },
    "destination_addresses": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Destination addresses."
    },
    "service": {
      "type": "string",
      "default": "any",
      "description": "Service or service group to match. Use 'any' for all services. (Note: NAT uses a singular string, not a list)."
    },
    "to_interface": {
      "type": "string",
      "description": "Egress interface."
    },
    "nat_type": {
      "type": "string",
      "enum": ["ipv4", "ipv6", "nptv6"],
      "default": "ipv4"
    },
    "source_translation_type": {
      "type": "string",
      "enum": ["none", "dynamic_ip_and_port", "dynamic_ip", "static_ip"],
      "description": "UI abstraction: Select the source translation mode."
    },
    "source_dyn_ip_port_mode": {
      "type": "string",
      "enum": ["interface_address", "translated_address"],
      "description": "Dynamic IP & Port: Use interface IP or an address pool?",
      "visibleWhen": { "field": "source_translation_type", "value": "dynamic_ip_and_port" }
    },
    "source_interface": {
      "type": "string",
      "description": "Interface name for dynamic IP & Port (e.g., ethernet1/1).",
      "visibleWhen": [
        { "field": "source_translation_type", "value": "dynamic_ip_and_port" },
        { "field": "source_dyn_ip_port_mode", "value": "interface_address" }
      ]
    },
    "source_interface_ip": {
      "type": "string",
      "description": "Specific IP on the interface (optional).",
      "visibleWhen": [
        { "field": "source_translation_type", "value": "dynamic_ip_and_port" },
        { "field": "source_dyn_ip_port_mode", "value": "interface_address" }
      ]
    },
    "source_dyn_ip_port_addresses": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Translated address pool names for Dynamic IP & Port.",
      "visibleWhen": [
        { "field": "source_translation_type", "value": "dynamic_ip_and_port" },
        { "field": "source_dyn_ip_port_mode", "value": "translated_address" }
      ]
    },
    "source_dynamic_ip_addresses": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Translated address pool names for Dynamic IP.",
      "visibleWhen": { "field": "source_translation_type", "value": "dynamic_ip" }
    },
    "static_translated_address": {
      "type": "string",
      "description": "Translated address for Static IP NAT.",
      "visibleWhen": { "field": "source_translation_type", "value": "static_ip" }
    },
    "bi_directional": {
      "type": "string",
      "enum": ["yes", "no"],
      "description": "Enable bi-directional Static NAT (PAN-OS quoted string: yes/no).",
      "visibleWhen": { "field": "source_translation_type", "value": "static_ip" }
    },
    "enable_destination_translation": {
      "type": "boolean",
      "description": "Enable destination NAT translation."
    },
    "destination_translated_address": {
      "type": "string",
      "description": "Translated destination address object name or IP.",
      "visibleWhen": { "field": "enable_destination_translation", "value": true }
    },
    "destination_translated_port": {
      "type": "number",
      "description": "Translated port number (numeric, will be unquoted in HCL).",
      "visibleWhen": { "field": "enable_destination_translation", "value": true }
    },
    "disabled": {
      "type": "boolean",
      "description": "Set to true to disable this rule.",
      "default": false
    },
    "tag": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Administrative tags (comma-separated)."
    },
    "group_tag": {
      "type": "string",
      "description": "Group tag for the rule."
    }
  },
  "required": [
    "name",
    "scope_type",
    "source_zones",
    "destination_zone",
    "source_addresses",
    "destination_addresses",
    "source_translation_type"
  ]
}