{
  "typeName": "panos/panos_addresses",
  "provider": "panos",
  "vendor": "Palo Alto Networks",
  "deviceType": "Bulk Address Objects",
  "supportedPlatforms": ["terraform"],
  "description": "Manages bulk PAN-OS Address Objects in a single resource (Provider v2.0.x).",
  "properties": {
    "name": {
      "type": "string",
      "description": "Terraform resource label only (e.g., bulk_dmz_addresses). Not passed to the provider."
    },
    "scope_type": {
      "type": "string",
      "enum": ["device_group", "shared", "vsys"]
    },
    "device_group_name": {
      "type": "string",
      "visibleWhen": {
        "field": "scope_type",
        "value": "device_group"
      }
    },
    "vsys_name": {
      "type": "string",
      "visibleWhen": {
        "field": "scope_type",
        "value": "vsys"
      }
    },
    "addresses": {
      "type": "array",
      "minItems": 1,
      "description": "Array of address objects to be converted to a map by the renderer.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "address_type": {
            "type": "string",
            "enum": [
              "ip_netmask",
              "ip_range",
              "fqdn",
              "ip_wildcard"
            ]
          },
          "value": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disable_override": {
            "type": "string",
            "enum": ["yes", "no"]
          }
        },
        "required": [
          "name",
          "address_type",
          "value"
        ]
      }
    }
  },
  "required": [
    "name",
    "scope_type",
    "addresses"
  ]
}