{
  "typeName": "panos_security_rule",
  "provider": "external",
  "properties": {
    "rule_name": {
      "type": "string",
      "description": "The name of the security rule."
    },
    "device_group": {
      "type": "string",
      "description": "The Panorama device group to apply this rule to."
    },
    "rulebase": {
      "type": "string",
      "description": "The rulebase (e.g., pre-rulebase, post-rulebase)."
    },
    "position": {
      "type": "string",
      "description": "Where to place the rule (e.g., top, bottom)."
    },
    "source_zones": {
      "type": "array",
      "description": "List of source security zones."
    },
    "destination_zones": {
      "type": "array",
      "description": "List of destination security zones."
    },
    "source_addresses": {
      "type": "array",
      "description": "List of source IP addresses or ranges."
    },
    "destination_addresses": {
      "type": "array",
      "description": "List of destination IP addresses or ranges."
    },
    "applications": {
      "type": "array",
      "description": "List of App-ID applications."
    },
    "services": {
      "type": "array",
      "description": "List of service objects."
    },
    "action": {
      "type": "string",
      "description": "Action to take (allow or deny)."
    },
    "log_end": {
      "type": "string",
      "description": "Log at session end (true/false)."
    }
  },
  "required": ["rule_name", "device_group", "source_zones", "destination_zones", "action"]
}