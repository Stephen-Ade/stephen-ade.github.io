{
  "typeName": "Microsoft.Resources/resourceGroups",
  "provider": "azure",
  "description": "Azure Resource Group (AVM)",
  "supportedPlatforms": [
    "terraform"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the resource group."
    },
    "location": {
      "type": "string",
      "description": "Azure region (e.g., eastus, westeurope)."
    },
    "tags": {
      "type": "object",
      "description": "Resource tags as JSON object."
    },
    "enable_telemetry": {
      "type": "boolean",
      "description": "Enable AVM telemetry."
    }
  },
  "required": [
    "name",
    "location"
  ]
}