{
  "typeName": "panos/panos_service",
  "provider": "panos",
  "vendor": "Palo Alto",
  "deviceType": "Service Object",
  "supportedPlatforms": ["terraform"],
  "description": "Manages a PAN-OS Service Object (Provider v2.0.x).",
  "properties": {
    "name": {
      "type": "string",
      "description": "PAN-OS object name (e.g., custom-web-8443). Preserved as-is in HCL."
    },
    "description": {
      "type": "string",
      "description": "Description of the service object."
    },
    "scope_type": {
      "type": "string",
      "description": "Where this object lives.",
      "enum": ["vsys", "device_group", "shared"],
      "default": "vsys"
    },
    "vsys_name": {
      "type": "string",
      "description": "The VSYS name (e.g., vsys1).",
      "visibleWhen": { "field": "scope_type", "value": "vsys" }
    },
    "device_group_name": {
      "type": "string",
      "description": "The Panorama device group name.",
      "visibleWhen": { "field": "scope_type", "value": "device_group" }
    },
    "protocol_type": {
      "type": "string",
      "description": "The protocol type.",
      "enum": ["tcp", "udp"]
    },
    "destination_port": {
      "type": "string",
      "description": "Destination port (e.g., 8443, 8000-8080, 80,443)"
    },
    "source_port": {
      "type": "string",
      "description": "Source port (usually 'any'). TCP only.",
      "visibleWhen": { "field": "protocol_type", "value": "tcp" }
    },
    "enable_timeout_override": {
      "type": "boolean",
      "description": "Enable custom session timeout override."
    },
    "timeout": {
      "type": "number",
      "description": "Session timeout in seconds.",
      "visibleWhen": { "field": "enable_timeout_override", "value": true }
    },
    "halfclose_timeout": {
      "type": "number",
      "description": "Half-close timeout in seconds (TCP only).",
      "visibleWhen": [
        { "field": "enable_timeout_override", "value": true },
        { "field": "protocol_type", "value": "tcp" }
      ]
    },
    "timewait_timeout": {
      "type": "number",
      "description": "Time-wait timeout in seconds (TCP only).",
      "visibleWhen": [
        { "field": "enable_timeout_override", "value": true },
        { "field": "protocol_type", "value": "tcp" }
      ]
    },
    "disable_override": {
      "type": "string",
      "description": "Prevent child firewalls from overriding. PAN-OS uses quoted string values (yes/no).",
      "visibleWhen": { "field": "scope_type", "value": "device_group" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Administrative tags (comma-separated)."
    }
  },
  "required": ["name", "scope_type", "protocol_type", "destination_port"]
}